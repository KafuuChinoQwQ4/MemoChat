# Copy to an ignored mode-0600 private env file. Replace every base
# REPLACE_WITH_* value and the values for each profile you enable; inactive
# profile lines may remain placeholders or be removed. Then use
# tools/scripts/release/run_release_compose.sh for config/up.
# Generate each secret independently, for example with: openssl rand -hex 32

MEMOCHAT_BACKEND_CONFIG_ROOT=REPLACE_WITH_ABSOLUTE_CONFIG_ROOT
MEMOCHAT_TLS_CERT_FILE=REPLACE_WITH_ABSOLUTE_TLS_CERT_PATH
MEMOCHAT_TLS_KEY_FILE=REPLACE_WITH_ABSOLUTE_TLS_KEY_PATH

MEMOCHAT_CPP_IMAGE_PREFIX=memochat
MEMOCHAT_IMAGE_TAG=local
MEMOCHAT_DOCKER_DATA_ROOT=/data/docker-data/memochat
MEMOCHAT_RUNTIME_UID=10001
MEMOCHAT_RUNTIME_GID=10001

MEMOCHAT_REDIS_PASSWORD=REPLACE_WITH_GENERATED_REDIS_SECRET

MEMOCHAT_POSTGRES_USER=memochat
MEMOCHAT_POSTGRES_DATABASE=memo_pg
MEMOCHAT_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_ADMIN_SECRET
MEMOCHAT_CHAT_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_CHAT_SECRET
MEMOCHAT_ACCOUNT_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_ACCOUNT_SECRET
MEMOCHAT_MEDIA_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_MEDIA_SECRET
MEMOCHAT_MOMENTS_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_MOMENTS_SECRET

MEMOCHAT_MONGO_ROOT_USERNAME=root
MEMOCHAT_MONGO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_MONGO_ROOT_SECRET
MEMOCHAT_MONGO_APP_USER=memochat_app
MEMOCHAT_MONGO_APP_PASSWORD=REPLACE_WITH_GENERATED_MONGO_APP_SECRET

MEMOCHAT_RABBITMQ_USER=memochat
MEMOCHAT_RABBITMQ_PASSWORD=REPLACE_WITH_GENERATED_RABBITMQ_SECRET

MEMOCHAT_MINIO_ROOT_USER=REPLACE_WITH_GENERATED_MINIO_ROOT_USER
MEMOCHAT_MINIO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_MINIO_ROOT_SECRET
MEMOCHAT_MINIO_APP_ACCESS_KEY=REPLACE_WITH_GENERATED_MINIO_APP_ACCESS_KEY
MEMOCHAT_MINIO_APP_SECRET_KEY=REPLACE_WITH_GENERATED_MINIO_APP_SECRET_KEY
MEMOCHAT_MINIO_PUBLIC_URL=http://127.0.0.1:9000

# Required only with --profile observability.
MEMOCHAT_INFLUXDB_USERNAME=memochat_admin
MEMOCHAT_INFLUXDB_PASSWORD=REPLACE_WITH_GENERATED_INFLUXDB_SECRET
MEMOCHAT_INFLUXDB_ADMIN_TOKEN=REPLACE_WITH_GENERATED_INFLUXDB_TOKEN
MEMOCHAT_GRAFANA_ADMIN_USER=memochat_admin
MEMOCHAT_GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_GRAFANA_SECRET

MEMOCHAT_CHATAUTH_HMACSECRET=REPLACE_WITH_GENERATED_CHAT_HMAC_SECRET
MEMOCHAT_AUTHTOKEN_JWTSECRET=REPLACE_WITH_GENERATED_JWT_SECRET
MEMOCHAT_AUTH_REFRESH_PEPPER=REPLACE_WITH_GENERATED_REFRESH_PEPPER

# Required only with --profile calls.
MEMOCHAT_CALL_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_CALL_SECRET
MEMOCHAT_LIVEKIT_API_KEY=REPLACE_WITH_GENERATED_LIVEKIT_API_KEY
MEMOCHAT_LIVEKIT_API_SECRET=REPLACE_WITH_GENERATED_LIVEKIT_API_SECRET
MEMOCHAT_LIVEKIT_URL=ws://127.0.0.1:7880

# Required only with --profile r18.
MEMOCHAT_R18_SOURCE_ADMIN_KEY=REPLACE_WITH_GENERATED_R18_ADMIN_KEY
MEMOCHAT_R18_PICACG_API_KEY=REPLACE_WITH_PROVISIONED_PICACG_API_KEY
MEMOCHAT_R18_PICACG_HMAC_KEY=REPLACE_WITH_PROVISIONED_PICACG_HMAC_KEY
MEMOCHAT_R18_CREDENTIAL_MASTER_KEY=REPLACE_WITH_64_HEX_R18_CREDENTIAL_MASTER_KEY

MEMOCHAT_EMAIL_SMTPUSER=REPLACE_WITH_PROVISIONED_SMTP_USER
MEMOCHAT_EMAIL_SMTPPASS=REPLACE_WITH_PROVISIONED_SMTP_SECRET
MEMOCHAT_EMAIL_FROM=REPLACE_WITH_PUBLIC_SENDER_ADDRESS
