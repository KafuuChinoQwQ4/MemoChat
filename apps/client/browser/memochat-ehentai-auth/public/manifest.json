{
  "manifest_version": 3,
  "name": "MemoChat E-Hentai Authentication",
  "version": "1.0.0",
  "description": "Secure E-Hentai/ExHentai login helper for MemoChat",
  "permissions": [
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://forums.e-hentai.org/*",
    "https://e-hentai.org/*",
    "https://exhentai.org/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
